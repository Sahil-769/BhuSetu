# --- App ---
APP_NAME=Bhoomi AI Backend
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+psycopg2://bhoomi:bhoomi@localhost:5432/bhoomi_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- File storage ---
UPLOAD_DIR=storage/uploads
VECTOR_STORE_DIR=storage/vector_store
MAX_UPLOAD_MB=25

# --- GenAI / LLM provider ---
# LLM_PROVIDER = "openai" (any OpenAI-compatible endpoint incl. local/OpenRouter) or "offline"
# "offline" needs no key and runs a safe extractive-summary fallback so the app works with no API key.
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# RAG
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
TOP_K_CHUNKS=5
